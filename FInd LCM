public class Main {
    public static int san(int a, int b) {
        int big = Math.max(a, b);
        int small = Math.min(a, b);
        int s = big;
        while (true) {
            if (big%small == 0){
                break;
            }
                big = big + s;
        }
            
            return big;
        }
    public static void main(String[] args)
    {
        int [] a = {56,2,6,25,64,12,32};
        int lcm = a[0];
        for (int i = 1; i <  7; i++)
        {
            lcm =  san(lcm, a[i]);
        }
        System.out.println("THE LCM is : " + lcm);
        
    }
        
    }

