public class Main {
    public static int fibo(int a){
        if (a == 1 || a <= 0)
            return 0;
        if (a == 2)
            return 1;
        return fibo(a - 1) + fibo(a - 2); 
    }
    public static void main(String[] args) {
        int n = 10;
        for (int i = 0; i < n; i++) {
            System.out.print(fibo(i) + " ");
        }
    }
}
